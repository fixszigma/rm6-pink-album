# RM6 Pink Album Configuration
PORT=3000
ALBUM_TITLE=RM6 Pink Album

# ลิงก์ Google Drive Folder กลาง (หรือ Folder ID)
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_DRIVE_FOLDER_ID=

# Google API Key (สำหรับอ่านโฟลเดอร์สาธารณะ) หรือ Service Account JSON
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Gemini API Key สำหรับใช้ AI วิเคราะห์และยืนยันใบหน้าความแม่นยำสูง
GEMINI_API_KEY=
ENABLE_GEMINI_AI=true
GEMINI_MODEL=gemini-3.8-flash

# ค่าความเข้มงวดในการจัดกลุ่มและค้นหาใบหน้า (0.35 - 0.65, ค่าเริ่มต้น 0.48)
FACE_MATCH_THRESHOLD=0.48
